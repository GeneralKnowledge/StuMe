# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
prisma/dev.db
prisma/dev.db-journal
*.db
*.db-journal

# RecipeNLG raw corpus and generated pipeline outputs
data/external/recipenlg/**
!data/external/recipenlg/.gitkeep
data/generated/**
!data/generated/**/.gitkeep
!data/generated/student-candidates/
!data/generated/student-candidates/.gitkeep
# Curated valid-candidate snapshot from the 5k-scale dry-run (not raw RecipeNLG)
!data/generated/student-candidates/valid-5k/
!data/generated/student-candidates/valid-5k/**

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma
